# Copy to `.env` for `docker compose up`. `.env` is git-ignored and must never be committed.
#
# The only value with no default is JWT_SECRET, deliberately. A development fallback secret is the
# most common way a production service ends up signing tokens with a value that is in a public
# repository -- and once one deployment has it, rotating is a coordinated outage.

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Local only. Compose passes this to both Postgres and the API's DATABASE_URL.
POSTGRES_PASSWORD=platform-local-only

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- the API also reads these; compose sets them, so they are here for reference ---------
#
# NODE_ENV=production
# PORT=4000
# DATABASE_URL=postgres://platform:platform-local-only@postgres:5432/platform
# REDIS_URL=redis://redis:6379
# CORS_ORIGINS=http://localhost:3000
# ALLOW_LOCALHOST_CORS=true    # only needed when NODE_ENV=production and the browser is local
# ACCESS_TOKEN_TTL_SECONDS=600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_REQUESTS=300
# AUTH_RATE_LIMIT_MAX_REQUESTS=10
#
# In production, DATABASE_URL and REDIS_URL are required: `loadConfig` refuses to start without
# them, because the in-process database is not durable and the in-memory key-value store is
# per-process -- so rate limits and token revocation would not be shared between replicas.

# --- the web client reads these at runtime, not at build time ----------------------------
#
# PLATFORM_API_URL=http://localhost:4000
# PLATFORM_WS_URL=ws://localhost:4000/ws
#
# These are the URLs the *browser* resolves, so in a cluster they are the public ingress
# hostnames, not in-cluster service names.

# --- optional: point the contract suites at real servers ---------------------------------
#
# The same suites that run against the in-process database and in-memory store also run against
# a real Postgres and a real Redis when these are set. CI sets them to service containers.
#
# TEST_DATABASE_URL=postgres://platform:platform-local-only@localhost:5432/platform
# TEST_REDIS_URL=redis://localhost:6379
